{
  "name": "swipetennis-com",
  "main": "apple/Backend/src/site-worker.mjs",
  "compatibility_date": "2026-11-12",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "APPLE_CLIENT_ID": "com.swipetennis.app" },
  "durable_objects": { "bindings": [{ "name": "CUPS", "class_name": "CupRoom" }] },
  "migrations": [{ "tag": "quick-cups-v1", "new_sqlite_classes": ["CupRoom"] }],
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "7312901", "simple": { "limit": 60, "period": 60 } }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "swipetennisdb",
    "database_id": "179ff7a4-c542-4499-b065-b038543465ae",
    "migrations_dir": "apple/Backend/migrations"
  }]
}
