{
  "name": "swipetennis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run db:migrate:ci",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply swipetennisdb --local",
    "db:migrate:remote": "wrangler d1 migrations apply swipetennisdb --remote",
    "db:migrate:ci": "node apple/Backend/scripts/migrate-ci.mjs",
    "test:api": "node --test apple/Backend/tests/*.test.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.0.0"
  }
}
